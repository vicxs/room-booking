{
  "name": "room-booking-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-generator-cli generate",
    "predev": "pnpm generate:api",
    "dev": "vite",
    "prebuild": "pnpm generate:api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm generate:api",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "pretest": "pnpm generate:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "pree2e": "pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@openapitools/openapi-generator-cli": "2.42.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
