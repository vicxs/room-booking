#!/usr/bin/env bash
# Computes the factory metrics (docs/factory.md, "Metrics") of every measured
# Intent from GitHub. Read-only: it uses plain `gh`, never scripts/bot-gh.
# Usage: scripts/factory-metrics [--since YYYY-MM-DD] [--json]
set -euo pipefail

# shellcheck source=SCRIPTDIR/bot-identity.sh
source "$(dirname "$0")/bot-identity.sh"

usage() {
  echo "Usage: $0 [--since YYYY-MM-DD] [--json]" >&2
  exit 2
}

json=false
while (($#)); do
  case $1 in
    --json) json=true ;;
    *) usage ;;
  esac
  shift
done

# Runs a read-only gh command and prints its JSON; --paginate pages (several
# arrays back to back) are merged into one array.
gh_read() {
  local out
  if ! out=$(gh "$@"); then
    echo "Error: 'gh $*' failed (see above). Is gh installed and authenticated for this repo?" >&2
    return 1
  fi
  jq -s 'if length == 1 then .[0] else add // [] end' <<<"$out"
}

merged_prs=$(gh_read pr list --state merged --limit 100000 \
  --json number,title,body,mergedAt,url,closingIssuesReferences)

intents=$(jq '[.[].closingIssuesReferences[].number] | unique | .[]' <<<"$merged_prs")
issues='{}'
for n in $intents; do
  issue=$(gh_read issue view "$n" --json number,title,createdAt,parent)
  timeline=$(gh_read api --paginate "repos/{owner}/{repo}/issues/$n/timeline")
  issue=$(jq --argjson timeline "$timeline" '.timeline = $timeline' <<<"$issue")
  issues=$(jq --argjson issue "$issue" '.[$issue.number | tostring] = $issue' <<<"$issues")
done

pr_numbers=$(jq '[.[] | select(.closingIssuesReferences != []) | .number] | .[]' <<<"$merged_prs")
pr_timelines='{}'
for n in $pr_numbers; do
  timeline=$(gh_read api --paginate "repos/{owner}/{repo}/issues/$n/timeline")
  pr_timelines=$(jq --arg n "$n" --argjson timeline "$timeline" '.[$n] = $timeline' <<<"$pr_timelines")
done

metrics=$(jq -n --argjson prs "$merged_prs" --argjson issues "$issues" \
  --argjson prTimelines "$pr_timelines" --arg botEmail "$BOT_EMAIL" '
  def ts: fromdateiso8601;
  def hours($from; $to): (($to | ts) - ($from | ts)) / 3600 * 10 | round / 10;
  def human: .type != "Bot";
  # Each human action in a timeline, as {at}: a review (its inline comments and
  # thread replies are part of a review: GitHub wraps each reply in a review of
  # its own), a comment, or a commit not authored by the bot.
  def actions:
    .[]
    | if .event == "reviewed" and .state != "pending" and (.user | human) then {at: .submitted_at, review: .state}
      elif .event == "commented" and (.actor | human) then {at: .created_at}
      elif .event == "committed" and .author.email != $botEmail then {at: .committer.date}
      else empty end;
  # A merged PR'"'"'s actions, without the final approval that precedes its merge.
  def pr_actions($pr):
    [ $prTimelines[$pr.number | tostring] | actions | select(.at <= $pr.mergedAt) ]
    | (map(select(.review == "approved")) | max_by(.at)) as $final
    | map(select(. != $final));
  [ $issues[] as $issue
    | [ $prs[] | select(any(.closingIssuesReferences[]; .number == $issue.number)) ] as $closing
    | ($closing | map(.mergedAt) | max) as $lastMerge
    | [ $issue.timeline[]
        | select(.event == "labeled" and .label.name == "ready-for-agent" and .created_at <= $lastMerge) ]
      as $alignments
    | ($alignments | map(.created_at) | max) as $alignment
    # Re-Alignment by the human is a touch: it happens at Alignment, not after.
    | ($alignments | sort_by(.created_at) | .[1:] | map(select(.actor | human)) | length) as $realignments
    | ([ $issue.timeline | actions ] + [ $closing[] as $pr | pr_actions($pr)[] ]
       | map(select(.at > $alignment and .at <= $lastMerge)) | length + $realignments) as $touches
    | { issue: $issue.number,
        title: $issue.title,
        prs: ($closing | map(.number) | sort),
        leadTimeHours: hours($issue.createdAt; $lastMerge),
        unattendedTimeHours: (if $alignment then hours($alignment; $lastMerge) else null end),
        humanTouches: (if $alignment then $touches else null end),
        reversions: 0 } ]
  | sort_by(.issue)')

if $json; then
  echo "$metrics"
  exit 0
fi

jq -r '
  def hours: if . == null then "—" elif . == (. | floor) then "\(.).0" else tostring end;
  def count: if . == null then "—" else tostring end;
  "| Issue | Title | PRs | Lead time (h) | Unattended time (h) | Human touches | Reversions |",
  "|---|---|---|---|---|---|---|",
  (.[] | "| #\(.issue) | \(.title | gsub("\\|"; "\\|")) | \(.prs | map("#\(.)") | join(", ")) | \(.leadTimeHours | hours) | \(.unattendedTimeHours | hours) | \(.humanTouches | count) | \(.reversions) |")
' <<<"$metrics"
