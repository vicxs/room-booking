#!/usr/bin/env bash
# `git` acting as the factory bot: commits are authored by it and pushes use its
# installation token over HTTPS, whatever the remote's URL. Usage: scripts/bot-git commit ... / scripts/bot-git push ...
set -euo pipefail

# shellcheck source=SCRIPTDIR/bot-identity.sh
source "$(dirname "$0")/bot-identity.sh"
token=$("$(dirname "$0")/bot-token")

export GIT_AUTHOR_NAME="$BOT_NAME" GIT_AUTHOR_EMAIL="$BOT_EMAIL"
export GIT_COMMITTER_NAME="$BOT_NAME" GIT_COMMITTER_EMAIL="$BOT_EMAIL"

if [[ "${1:-}" == "push" ]]; then
  shift
  exec git -c credential.helper= \
    -c "credential.helper=!f() { echo username=x-access-token; echo password=$token; }; f" \
    -c "url.https://github.com/.pushInsteadOf=git@github.com:" \
    push "$@"
fi
exec git "$@"
